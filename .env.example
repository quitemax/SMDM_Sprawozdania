# Skopiuj do .env (gitignorowany, nigdy nie commituj prawdziwych wartości)
# i uzupełnij prawdziwym tokenem Hugging Face — patrz docs/INSTALLATION.md,
# sekcja o tokenie HF i dostępie do modeli pyannote.
HF_TOKEN=hf_...

# Potrzebne tylko dla Kroku 2 (webowy interfejs, docker-compose.web.yml) —
# hasła do MariaDB. Ustaw na dowolne własne wartości.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-smdm
