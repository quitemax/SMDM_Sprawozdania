# ============================================================
# Dane poufne (nagrania, transkrypcje, sprawozdania, archiwum)
# ============================================================

input/audio/*
!input/audio/.gitkeep

input/historical_data/reports/*
!input/historical_data/reports/.gitkeep

input/historical_data/reports_md/*
!input/historical_data/reports_md/.gitkeep

input/historical_data/transcripts/*
!input/historical_data/transcripts/.gitkeep

output/reports/*
!output/reports/.gitkeep

output/transcripts/*
!output/transcripts/.gitkeep

# ============================================================
# Python
# ============================================================

.venv/
venv/
env/

__pycache__/
*.py[cod]

.pytest_cache/
.mypy_cache/

# ============================================================
# Web (Etap 8, Krok 2 — Symfony + Nuxt)
# ============================================================

# Symfony
web/backend/vendor/
web/backend/var/
web/backend/.env.local
web/backend/.env.local.php
web/backend/.env.*.local

# Nuxt
web/frontend/node_modules/
web/frontend/.nuxt/
web/frontend/.output/
web/frontend/dist/

# ============================================================
# Środowisko / konfiguracja lokalna
# ============================================================

.env
.env.*
!.env.example
# web/backend/.env jest plikiem Symfony z bezpiecznymi wartościami domyślnymi
# (Symfony commituje .env, prawdziwe sekrety idą do gitignorowanego .env.local) —
# patrz web/backend/.gitignore, gdzie Symfony Flex już to poprawnie skonfigurował.
!web/backend/.env

.vscode/
.claude/

# ============================================================
# System Windows
# ============================================================

Thumbs.db
Desktop.ini
